# JWT Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256

# Access/refresh token lifetimes and login-hardening — see CLAUDE.md's Auth
# section for the full mechanism (refresh-token rotation/reuse-detection,
# login lockout, IP throttling, the reverse-proxy --proxy-headers note).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to false only for local non-HTTPS dev — the refresh-token cookie's
# Secure flag depends on this.
COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (defaults to postgresql+asyncpg://postgres:postgres@localhost/quanttrade if unset)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/quanttrade

# Alpha Vantage API key, used by POST /api/data/import/{ticker} to pull market
# data by ticker symbol. Free, no card required: https://www.alphavantage.co/support/#api-key
# Falls back to the public "demo" key (only works for a few sample symbols,
# e.g. IBM) if unset. Can also be supplied per-request via the `api_key` param
# instead of setting it here.
ALPHA_VANTAGE_API_KEY=demo

# Celery broker (Redis). Used for async backtest/import task execution —
# see docs/superpowers/specs/2026-08-14-celery-redis-async-tasks-design.md.
# Defaults to localhost for bare `uv run uvicorn` dev; docker-compose.yml
# overrides this to redis://redis:6379/0 for both backend and worker.
CELERY_BROKER_URL=redis://localhost:6379/0

# Sandboxed custom-code strategy execution limits (services/sandbox_executor.py).
# Defaults below match what ships if these are unset — raise them if
# sklearn-based strategies need more room to train than pandas indicator
# math does; keep them low on resource-constrained dev machines.
SANDBOX_TIMEOUT_S=10
SANDBOX_MEM_LIMIT_MB=512
SANDBOX_CPU_LIMIT_S=8
