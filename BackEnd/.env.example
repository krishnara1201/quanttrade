# JWT Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (defaults to postgresql+asyncpg://postgres:postgres@localhost/quanttrade if unset)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/quanttrade

# Alpha Vantage API key, used by POST /api/data/import/{ticker} to pull market
# data by ticker symbol. Free, no card required: https://www.alphavantage.co/support/#api-key
# Falls back to the public "demo" key (only works for a few sample symbols,
# e.g. IBM) if unset. Can also be supplied per-request via the `api_key` param
# instead of setting it here.
ALPHA_VANTAGE_API_KEY=demo

# Celery broker (Redis). Used for async backtest/import task execution —
# see docs/superpowers/specs/2026-08-14-celery-redis-async-tasks-design.md.
# Defaults to localhost for bare `uv run uvicorn` dev; docker-compose.yml
# overrides this to redis://redis:6379/0 for both backend and worker.
CELERY_BROKER_URL=redis://localhost:6379/0
